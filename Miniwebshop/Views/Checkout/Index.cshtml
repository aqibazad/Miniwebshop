@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewBag.Title = "Checkout";

    var cartItems = ViewBag.CartItems as List<Application.DTOs.CartItemDto> ?? new List<Application.DTOs.CartItemDto>();
    bool hasValidStock = ViewBag.HasValidStock is bool valid && valid;
    bool hasStockError = TempData["StockError"] != null;
    bool hasItems = cartItems.Any();
    var totalAmount = cartItems.Sum(item => item.Subtotal);
}

<div class="checkout-container">
    <!-- Top Header -->
    <div class="checkout-top-bar">
        <div class="flex-center">
            <i class="fas fa-shopping-bag"></i>
            <div>
                <h1>Checkout</h1>
                <span class="item-count">@(hasItems ? $"{cartItems.Count} items" : "Empty Cart")</span>
            </div>
        </div>
    </div>

    @if (hasStockError)
    {
        <div class="error-alert flex-center">
            <i class="fas fa-exclamation-circle"></i>
            <span>@TempData["StockError"]</span>
            <button class="close-btn">&times;</button>
        </div>
    }

    @if (hasItems)
    {
        <form asp-action="PlaceOrder" method="post" id="checkoutForm" class="checkout-form">
            @Html.AntiForgeryToken()

            <!-- Compact Address & Items Row -->
            <div class="content-row">
                <!-- Left Column - Address -->
                <div class="left-column">
                    <div class="section-compact">
                        <div class="section-title flex-center">
                            <i class="fas fa-map-marker-alt"></i>
                            <span>Shipping Address</span>
                        </div>
                        <textarea name="shippingAddress" class="address-field" rows="2" required
                              placeholder="Full address..."></textarea>
                    </div>

                    @if (!hasValidStock)
                    {
                        <div class="stock-alert flex-center">
                            <i class="fas fa-exclamation-triangle"></i>
                            <span>Low stock items detected</span>
                            <a href="/Cart/index">Update Cart</a>
                        </div>
                    }
                </div>

                <!-- Right Column - Items Summary -->
                <div class="right-column">
                    <div class="items-compact">
                        <div class="section-title flex-center">
                            <i class="fas fa-list"></i>
                            <span>Order Items</span>
                        </div>
                        <div class="items-scroll">
                            @foreach (var item in cartItems.Take(3)) // Show max 3 items
                            {
                                <div class="item-compact @(item.HasSufficientStock ? "" : "stock-issue") flex-between">
                                    <div class="item-left">
                                        <div class="item-name truncate">@item.ProductName</div>
                                        <div class="item-qty">Qty: @item.Quantity</div>
                                    </div>
                                    <div class="item-right">
                                        <span class="price">@item.Subtotal.ToString("F2")</span>
                                        @if (!item.HasSufficientStock)
                                        {
                                            <span class="stock-low">Low</span>
                                        }
                                    </div>
                                </div>
                            }
                            @if (cartItems.Count > 3)
                            {
                                <div class="more-items flex-center">
                                    +@(cartItems.Count - 3) more items
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bottom Summary & Action -->
            <div class="bottom-section">
                <div class="total-display flex-between">
                    <span>Total</span>
                    <div>
                        <span class="amount">@totalAmount.ToString("F2")</span>
                        <div class="items-info">@cartItems.Count items</div>
                    </div>
                </div>

                <div class="action-area">
                    @if (!hasValidStock)
                    {
                        <button type="button" class="btn-primary disabled flex-center" disabled>
                            <i class="fas fa-lock"></i>
                            Update Cart
                        </button>
                    }
                    else
                    {
                        <button type="submit" class="btn-primary flex-center" id="placeOrderBtn">
                            <i class="fas fa-credit-card"></i>
                            Place Order
                        </button>
                    }
                    <div class="security-info flex-center">
                        <i class="fas fa-shield-alt"></i>
                        <span>SSL Secure</span>
                    </div>
                </div>
            </div>

            @if (!hasValidStock)
            {
                <div class="cart-link flex-center">
                    <a href="/Cart/Index">
                        <i class="fas fa-shopping-cart"></i>
                        Review Cart
                    </a>
                </div>
            }
        </form>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon flex-center">
                <i class="fas fa-shopping-cart"></i>
            </div>
            <h3>Empty Cart</h3>
            <p>Add items to checkout</p>
            <a href="/Catalog/Categories" class="btn-secondary flex-center">
                <i class="fas fa-store"></i>
                Shop Now
            </a>
        </div>
    }
</div>

<style>
    :root {
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --success: #059669;
        --warning: #d97706;
        --error: #dc2626;
        --gray-50: #f9fafb;
        --gray-100: #f3f4f6;
        --gray-200: #e5e7eb;
        --gray-600: #4b5563;
        --gray-800: #1f2937;
        --border-radius: 10px;
        --shadow: 0 2px 10px rgba(0,0,0,0.08);
    }

    * {
        box-sizing: border-box;
    }

    .checkout-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 16px;
        background: var(--gray-50);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    /* Top Bar */
    .checkout-top-bar {
        background: white;
        padding: 16px;
        border-radius: var(--border-radius);
        margin-bottom: 16px;
        box-shadow: var(--shadow);
        border: 1px solid var(--gray-200);
    }

    .flex-center {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .flex-between {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .checkout-top-bar i {
        color: var(--primary);
        font-size: 24px;
    }

    .checkout-top-bar h1 {
        margin: 0;
        font-size: 20px;
        color: var(--gray-800);
    }

    .item-count {
        font-size: 14px;
        color: var(--gray-600);
    }

    /* Error Alert */
    .error-alert {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: var(--error);
        padding: 12px 16px;
        border-radius: var(--border-radius);
        margin-bottom: 16px;
        gap: 8px;
    }

    .close-btn {
        margin-left: auto;
        background: none;
        border: none;
        font-size: 20px;
        cursor: pointer;
        color: var(--error);
    }

    /* Content Row */
    .content-row {
        display: flex;
        gap: 16px;
        flex: 1;
        margin-bottom: 16px;
    }

    .left-column {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .right-column {
        flex: 0 0 280px;
        display: flex;
        flex-direction: column;
    }

    .section-compact {
        background: white;
        border-radius: var(--border-radius);
        box-shadow: var(--shadow);
        border: 1px solid var(--gray-200);
        overflow: hidden;
    }

    .section-title {
        padding: 12px 16px;
        background: var(--gray-100);
        font-size: 14px;
        font-weight: 600;
        color: var(--gray-800);
        gap: 8px;
    }

        .section-title i {
            color: var(--primary);
            font-size: 16px;
        }

    /* Address Field */
    .address-field {
        width: 100%;
        padding: 12px 16px;
        border: none;
        border-top: 1px solid var(--gray-200);
        font-size: 14px;
        resize: none;
        background: white;
    }

        .address-field:focus {
            outline: none;
        }

    /* Stock Alert */
    .stock-alert {
        background: #fffbeb;
        border: 1px solid #fde68a;
        color: var(--warning);
        padding: 12px;
        border-radius: var(--border-radius);
        gap: 8px;
        font-size: 13px;
    }

        .stock-alert a {
            color: var(--primary);
            text-decoration: none;
            font-weight: 500;
            margin-left: auto;
        }

    /* Items Compact */
    .items-scroll {
        max-height: 200px;
        overflow-y: auto;
        padding: 8px 0;
    }

    .item-compact {
        padding: 8px 16px;
        border-bottom: 1px solid var(--gray-200);
        font-size: 13px;
    }

        .item-compact.stock-issue {
            background: rgba(254, 242, 242, 0.5);
        }

    .item-name {
        font-weight: 500;
        color: var(--gray-800);
        margin-bottom: 2px;
        max-width: 140px;
    }

    .truncate {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .item-qty {
        color: var(--gray-600);
        font-size: 12px;
    }

    .price {
        color: var(--success);
        font-weight: 600;
        margin-left: 8px;
    }

    .stock-low {
        background: #fecaca;
        color: var(--error);
        padding: 2px 6px;
        border-radius: 6px;
        font-size: 11px;
        margin-left: 8px;
    }

    .more-items {
        padding: 8px 16px;
        color: var(--gray-600);
        font-size: 12px;
    }

    /* Bottom Section */
    .bottom-section {
        background: white;
        border-radius: var(--border-radius);
        padding: 20px;
        box-shadow: var(--shadow);
        border: 1px solid var(--gray-200);
        margin-bottom: 16px;
    }

    .total-display {
        font-size: 16px;
        margin-bottom: 16px;
    }

    .amount {
        font-size: 24px;
        color: var(--success);
        font-weight: 600;
    }

    .items-info {
        font-size: 12px;
        color: var(--gray-600);
    }

    .action-area {
        text-align: center;
    }

    .btn-primary {
        width: 100%;
        padding: 14px;
        border: none;
        border-radius: var(--border-radius);
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        gap: 8px;
        transition: all 0.2s;
    }

        .btn-primary:not(.disabled) {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
        }

            .btn-primary:not(.disabled):hover {
                transform: translateY(-1px);
                box-shadow: var(--shadow);
            }

        .btn-primary.disabled {
            background: var(--gray-200);
            color: var(--gray-600);
            cursor: not-allowed;
        }

    .security-info {
        margin-top: 12px;
        font-size: 12px;
        color: var(--gray-600);
        gap: 6px;
    }

        .security-info i {
            color: var(--success);
        }

    /* Cart Link */
    .cart-link {
        background: var(--gray-100);
        padding: 12px;
        border-radius: var(--border-radius);
        text-align: center;
    }

        .cart-link a {
            color: var(--primary);
            text-decoration: none;
            font-weight: 500;
            gap: 6px;
        }

    /* Empty State */
    .empty-state {
        background: white;
        border-radius: var(--border-radius);
        padding: 40px 20px;
        text-align: center;
        box-shadow: var(--shadow);
        border: 1px solid var(--gray-200);
        margin-top: 20px;
    }

    .empty-icon {
        width: 60px;
        height: 60px;
        background: var(--gray-100);
        border-radius: 50%;
        margin-bottom: 16px;
    }

        .empty-icon i {
            font-size: 24px;
            color: var(--gray-600);
        }

    .empty-state h3 {
        color: var(--gray-800);
        margin-bottom: 8px;
    }

    .empty-state p {
        color: var(--gray-600);
        margin-bottom: 20px;
    }

    .btn-secondary {
        background: var(--primary);
        color: white;
        padding: 12px 24px;
        border-radius: var(--border-radius);
        text-decoration: none;
        font-weight: 500;
        gap: 8px;
        display: inline-flex;
        transition: all 0.2s;
    }

        .btn-secondary:hover {
            background: var(--primary-dark);
        }

    /* Scrollbar */
    .items-scroll::-webkit-scrollbar {
        width: 4px;
    }

    .items-scroll::-webkit-scrollbar-thumb {
        background: var(--gray-400);
        border-radius: 2px;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .content-row

    {
        flex-direction: column;
    }

    .right-column {
        flex: 1;
        max-width: 100%;
    }

    .checkout-container {
        padding: 12px;
    }

    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('checkoutForm');
        const submitBtn = document.getElementById('placeOrderBtn');
        const closeBtn = document.querySelector('.close-btn');

        if (closeBtn) {
            closeBtn.addEventListener('click', () => {
                closeBtn.parentElement.style.display = 'none';
            });
        }

        if (form && submitBtn && !submitBtn.disabled) {
            form.addEventListener('submit', () => {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
            });
        }
    });
</script>