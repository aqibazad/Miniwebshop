<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - Mini Webshop</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #0f0c29;
            background: linear-gradient(to right, #24243e, #302b63, #0f0c29);
            position: relative;
            overflow-x: hidden;
            padding: 40px 20px;
        }

        /* Animated Background */
        .bg-animation {
            position: fixed;
            width: 100%;
            height: 100%;
            overflow: hidden;
            top: 0;
            left: 0;
        }

        .shape {
            position: absolute;
            border-radius: 50%;
            background: linear-gradient(45deg, rgba(255,255,255,0.05), rgba(255,255,255,0.1));
            animation: moveShape 20s infinite alternate;
        }

            .shape:nth-child(1) {
                width: 300px;
                height: 300px;
                top: -100px;
                left: -100px;
                animation-duration: 15s;
            }

            .shape:nth-child(2) {
                width: 200px;
                height: 200px;
                top: 50%;
                right: -50px;
                animation-duration: 18s;
                animation-delay: 2s;
            }

            .shape:nth-child(3) {
                width: 250px;
                height: 250px;
                bottom: -80px;
                left: 30%;
                animation-duration: 22s;
                animation-delay: 4s;
            }

        @@keyframes moveShape {
            0%

        {
            transform: translate(0, 0) rotate(0deg);
        }

        100% {
            transform: translate(50px, 50px) rotate(360deg);
        }

        }

        /* Main Container */
        .register-card {
            position: relative;
            z-index: 10;
            width: 500px;
            max-width: 90%;
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
            overflow: hidden;
            animation: slideIn 0.6s ease-out;
        }

        @@keyframes slideIn {
            from

        {
            opacity: 0;
            transform: translateY(-30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        /* Header Section */
        .register-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 30px 30px 25px;
            text-align: center;
            position: relative;
        }

            .register-header::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: url('data:image/svg+xml,<svg width="100" height="100" xmlns="http://www.w3.org/2000/svg"><circle cx="50" cy="50" r="40" fill="rgba(255,255,255,0.03)"/></svg>');
                opacity: 0.5;
            }

        .logo-circle {
            width: 70px;
            height: 70px;
            margin: 0 auto 15px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(10px);
            animation: pulse 2s ease-in-out infinite;
            position: relative;
        }

        @@keyframes pulse {
            0%, 100%

        {
            transform: scale(1);
            box-shadow: 0 0 0 0 rgba(255,255,255,0.4);
        }

        50% {
            transform: scale(1.05);
            box-shadow: 0 0 0 15px rgba(255,255,255,0);
        }

        }

        .logo-circle i {
            font-size: 32px;
            color: #fff;
        }

        .register-header h1 {
            color: #fff;
            font-size: 26px;
            font-weight: 700;
            margin-bottom: 6px;
            position: relative;
        }

        .register-header p {
            color: rgba(255, 255, 255, 0.9);
            font-size: 13px;
            font-weight: 400;
            position: relative;
        }

        /* Form Section */
        .register-body {
            padding: 30px 30px 35px;
        }

        .input-group {
            margin-bottom: 18px;
        }

            .input-group label {
                display: block;
                color: #333;
                font-size: 13px;
                font-weight: 600;
                margin-bottom: 7px;
            }

        .input-field {
            position: relative;
        }

            .input-field input,
            .input-field textarea {
                width: 100%;
                padding: 12px 15px 12px 45px;
                border: 2px solid #e0e0e0;
                border-radius: 10px;
                font-size: 14px;
                transition: all 0.3s ease;
                background: #f8f9fa;
                font-family: 'Poppins', sans-serif;
            }

            .input-field textarea {
                min-height: 80px;
                resize: vertical;
            }

                .input-field input:focus,
                .input-field textarea:focus {
                    outline: none;
                    border-color: #667eea;
                    background: #fff;
                    box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
                }

            .input-field i {
                position: absolute;
                left: 15px;
                top: 15px;
                color: #667eea;
                font-size: 16px;
                transition: all 0.3s ease;
            }

            .input-field input:focus + i,
            .input-field textarea:focus + i {
                color: #764ba2;
            }

        .help-text {
            font-size: 12px;
            color: #888;
            margin-top: 5px;
        }

        .text-danger {
            font-size: 12px;
            color: #dc3545;
            margin-top: 5px;
            display: block;
        }

        /* Register Button */
        .register-btn {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            border-radius: 10px;
            color: #fff;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            font-family: 'Poppins', sans-serif;
            margin-top: 10px;
        }

            .register-btn::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
                transition: left 0.6s;
            }

            .register-btn:hover::before {
                left: 100%;
            }

            .register-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
            }

            .register-btn:active {
                transform: translateY(0);
            }

            .register-btn i {
                margin-right: 8px;
            }

        /* Divider */
        .divider {
            display: flex;
            align-items: center;
            margin: 20px 0 18px;
        }

            .divider::before,
            .divider::after {
                content: '';
                flex: 1;
                height: 1px;
                background: #ddd;
            }

            .divider span {
                padding: 0 15px;
                color: #888;
                font-size: 13px;
            }

        /* Login Link */
        .login-link {
            text-align: center;
        }

            .login-link p {
                color: #666;
                font-size: 13px;
                margin-bottom: 8px;
            }

            .login-link a {
                color: #667eea;
                text-decoration: none;
                font-weight: 600;
                font-size: 14px;
                transition: all 0.3s ease;
                display: inline-flex;
                align-items: center;
            }

                .login-link a:hover {
                    color: #764ba2;
                    transform: translateX(3px);
                }

                .login-link a i {
                    margin-right: 5px;
                }

        /* Alert Message */
        .alert {
            padding: 11px 14px;
            background: #fee;
            border: 1px solid #fcc;
            border-radius: 8px;
            color: #c33;
            font-size: 13px;
            margin-bottom: 18px;
            display: flex;
            align-items: center;
            animation: shake 0.5s;
        }

            .alert i {
                margin-right: 8px;
                font-size: 15px;
            }

        @@keyframes shake {
            0%, 100%

        {
            transform: translateX(0);
        }

        25% {
            transform: translateX(-8px);
        }

        75% {
            transform: translateX(8px);
        }

        }

        /* Responsive */
        @@media (max-width: 576px) {
            body

        {
            padding: 30px 15px;
        }

        .register-card {
            width: 100%;
        }

        .register-header {
            padding: 25px 20px 20px;
        }

        .logo-circle {
            width: 60px;
            height: 60px;
        }

            .logo-circle i {
                font-size: 28px;
            }

        .register-header h1 {
            font-size: 22px;
        }

        .register-body {
            padding: 25px 20px 30px;
        }

        .input-field input,
        .input-field textarea {
            padding: 11px 15px 11px 42px;
        }

        }

        @@media (max-width: 360px) {
            .register-body

        {
            padding: 20px 15px 25px;
        }

        }
    </style>
</head>
<body>
    <div class="bg-animation">
        <div class="shape"></div>
        <div class="shape"></div>
        <div class="shape"></div>
    </div>

    <div class="register-card">
        <div class="register-header">
            <div class="logo-circle">
                <i class="fas fa-user-plus"></i>
            </div>
            <h1>Create Account</h1>
            <p>Join us and start shopping today</p>
        </div>

        <div class="register-body">
            <form action="/Account/Register" method="post">
                <!-- Anti-forgery token -->
                <input name="__RequestVerificationToken" type="hidden" value="" />

                <!-- Error Message (Uncomment when needed) -->
                <!-- <div class="alert">
                    <i class="fas fa-exclamation-circle"></i>
                    <span>Please correct the errors below</span>
                </div> -->

                <div class="input-group">
                    <label for="Name">Full Name</label>
                    <div class="input-field">
                        <input type="text" id="Name" name="Name" placeholder="John Doe" required>
                        <i class="fas fa-user"></i>
                    </div>
                    <span class="text-danger"></span>
                </div>

                <div class="input-group">
                    <label for="Email">Email Address</label>
                    <div class="input-field">
                        <input type="email" id="Email" name="Email" placeholder="your@@email.com" required>
                        <i class="fas fa-envelope"></i>
                    </div>
                    <span class="text-danger"></span>
                </div>

                <div class="input-group">
                    <label for="password">Password</label>
                    <div class="input-field">
                        <input type="password" id="password" name="password" placeholder="Create a password" required>
                        <i class="fas fa-lock"></i>
                    </div>
                    <small class="help-text">Must be at least 6 characters</small>
                </div>

                <div class="input-group">
                    <label for="Phone">Phone Number</label>
                    <div class="input-field">
                        <input type="tel" id="Phone" name="Phone" placeholder="+1234567890" required>
                        <i class="fas fa-phone"></i>
                    </div>
                    <span class="text-danger"></span>
                </div>

                <div class="input-group">
                    <label for="ShippingAddress">Shipping Address</label>
                    <div class="input-field">
                        <textarea id="ShippingAddress" name="ShippingAddress" placeholder="Enter your complete address" required></textarea>
                        <i class="fas fa-map-marker-alt"></i>
                    </div>
                    <span class="text-danger"></span>
                </div>

                <button type="submit" class="register-btn">
                    <i class="fas fa-user-check"></i>Create Account
                </button>

                <div class="divider">
                    <span>OR</span>
                </div>

                <div class="login-link">
                    <p>Already have an account?</p>
                    <a href="/Account/Login">
                        <i class="fas fa-sign-in-alt"></i>Sign In
                    </a>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>